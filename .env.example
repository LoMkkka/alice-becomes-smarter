# Required
GROQ_API_KEY=gsk_your_key_here

# Optional
GROQ_MODEL=qwen/qwen3.8-27b
MODEL_TIMEOUT_SECONDS=3.0
MAX_OUTPUT_TOKENS=120
MAX_HISTORY_MESSAGES=10

# Home defaults.
# HOME_CITY makes "какая погода?" work without naming a city.
# Examples: Москва, Санкт-Петербург, Казань
HOME_CITY=

# Optional IANA timezone override.
# Leave blank to use meta.timezone sent by Yandex.
# Examples: Europe/Moscow, Europe/Kaliningrad, Asia/Yekaterinburg
HOME_TIMEZONE=

# Timeout for one Open-Meteo HTTP request.
WEATHER_TIMEOUT_SECONDS=1.0

# true logs full Yandex requests and final answers to journalctl.
# Requests may contain user/session identifiers, so keep this false in normal use.
LOG_REQUESTS=false

PROMPT_FILE=/opt/alice-gpt/prompt.txt
